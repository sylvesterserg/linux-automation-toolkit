# Global environment variables for the automation hub stack
# Copy this file to .env and fill in the values before deploying.

# DNS & networking
ACME_EMAIL=admin@example.com
CLOUDFLARE_API_TOKEN=cf_api_token_with_dns_edit
CLOUDFLARE_TUNNEL_TOKEN=cf_tunnel_token
DOCKER_NETWORK_NAME=automation_net
N8N_DOMAIN=automations.example.com

# n8n authentication
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=super-secret-password

# Additional configuration for n8n. Keep this file out of version control in production.
# Documentation: https://docs.n8n.io/hosting/configuration/

N8N_ENCRYPTION_KEY=replace_with_32_character_key
N8N_USER_MANAGEMENT_DISABLED=false
EXECUTIONS_MODE=regular
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168

# Example webhook URLs for integrations
TELEGRAM_WEBHOOK_URL=https://api.telegram.org/botTOKEN/setWebhook
NOTION_API_KEY=secret_notion_token
GITHUB_ACCESS_TOKEN=ghp_exampletoken
TRADINGVIEW_WEBHOOK_SECRET=replace_me
